# Optional node-local limits; the complete workflow engine is not included.
WORKFLOW_MAX_LOOP_TIMES=100
WORKFLOW_PARALLEL_MAX_CONCURRENCY=10

# Server-only model configuration; never use NEXT_PUBLIC_ for these variables.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=workflow
MONGODB_AUTH_SOURCE=workflow
MONGODB_USER=workflow
MONGODB_PASSWORD=
MONGODB_TLS=false
# Only needed once to migrate old encrypted model credentials; not used at runtime.
MODEL_CREDENTIAL_KEY=

# Optional local document processing and file storage.
WORKFLOW_FILE_DIR=.workflow-data/files
PARSE_FILE_WORKERS=4
PARSE_FILE_TIMEOUT_SECONDS=120
MAX_HTML_TRANSFORM_CHARS=1000000

# Agent files live in MongoDB. New sessions allow an in-memory Shell by default.
WORKFLOW_SANDBOX_MODE=isolated-shell
# Emergency server-side host Shell kill switch; mode is otherwise selected in /shell.
WORKFLOW_HOST_SHELL_DISABLED=0
# Optional original Code Sandbox runner; leave unset for the bundled WASM runtime.
# WORKFLOW_CODE_SANDBOX_URL=http://127.0.0.1:16082
# WORKFLOW_CODE_SANDBOX_TOKEN=
