{
  "name": "zjt-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 16080",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 16080",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:capabilities": "node scripts/smoke-capabilities.mjs",
    "test:api": "tsx scripts/smoke-workflow-nodes.ts",
    "test:models": "node --env-file=.env.local scripts/smoke-model-config.mjs",
    "migrate:model-credentials": "node --env-file=.env.local --import tsx scripts/migrate-model-credentials.ts",
    "migrate:nodes": "node scripts/migrate-workflow-nodes.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "gpt-tokenizer": "3.4.0",
    "iconv-lite": "0.6.3",
    "joplin-turndown-plugin-gfm": "1.0.12",
    "json5": "^2.2.3",
    "jszip": "3.10.1",
    "lodash": "4.17.23",
    "lucide-react": "^1.74.0",
    "mammoth": "1.11.0",
    "mongodb": "^7.9.0",
    "nanoid": "^5.1.16",
    "next": "16.4.6",
    "papaparse": "5.4.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "7.2.0",
    "xlsx": "0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
